# Public site URL used for canonicals, sitemap, Open Graph, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://houseofkani.com

# Payload CMS origin for server-side REST reads (no trailing slash).
CMS_URL=https://cms.houseofkani.com
# Viewer API key issued by the CMS (`pnpm seed`) — enables draft preview reads.
CMS_API_KEY=

# Shared secrets — must match the CMS environment.
PREVIEW_SECRET=
REVALIDATE_SECRET=
