# Public site URL used for canonicals, sitemap, Open Graph, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://houseofkani.com

# Payload CMS origin for server-side REST reads (no trailing slash).
# Stable public origin: exe.dev HTTPS proxy -> Caddy -> Payload on the VM.
# Do not use ephemeral *.trycloudflare.com quick tunnels here — they stop
# resolving whenever cloudflared restarts and silently break the Journal.
CMS_URL=https://house-of-kani-cms.exe.xyz
# Viewer API key issued by the CMS (`pnpm seed`) — enables draft preview reads.
CMS_API_KEY=

# Shared secrets — must match the CMS environment.
PREVIEW_SECRET=
REVALIDATE_SECRET=

# Transactional email (Resend). Leave blank to disable — the enquiry form falls
# back to a mailto link and /api/enquiry answers 503.
RESEND_API_KEY=
# Sender. Until houseofkani.com is verified in Resend this must stay the test
# sender; then switch to e.g. "House of Kani <hello@houseofkani.com>".
EMAIL_FROM=House of Kani <onboarding@resend.dev>
# Where enquiries land.
ENQUIRY_TO_EMAIL=contact.houseofkani@gmail.com
# Send the visitor a confirmation copy (needs a verified domain).
EMAIL_ACKNOWLEDGEMENTS=false
